# Copia este archivo como .env y completa los valores.

# Puerto COM del adaptador USB-serie (ej. COM16) o "auto": busca el adaptador donde responde el POS,
# aunque Windows le cambie el número al conectarlo en otro puerto USB.
POS_PORT=auto
POS_BAUD=19200
POS_DEBUG=0
POS_VOUCHER=1
POS_ACK_TIMEOUT=3000
POS_RESP_TIMEOUT=75000
# Tras un corte del puerto, reintenta la conexión cada N ms y verifica los pagos pendientes
POS_RECONEXION_MS=10000

# BACKEND_URL=http://localhost:3000/pos/pendiente

DATABASE_URL=postgres://postgres:TU_CLAVE@localhost:5432/im30

# --- Backend HTTP (server.js) ---
PORT=3000
HOST=127.0.0.1
# API_KEY=pon-una-clave-larga

# Al conectar con el POS: poll + carga de llaves (0800). 0 = desactivar
POS_LLAVES_AL_CONECTAR=1
# Máximo para esperar la carga de llaves (ms)
POS_LLAVES_TIMEOUT=70000

# --- Voucher (se imprime tras cada venta aprobada, como transbank_ws) ---
VOUCHER_IMPRIMIR=0
# Nombre exacto de la impresora en Windows (en el kiosco: Star TUP900 (TUP942)). Vacío = predeterminada
VOUCHER_IMPRESORA=Star TUP900 (TUP942)
VOUCHER_DIR=vouchers


# Cierre diario automático HH:MM (manual IM30: diario o mínimo semanal). Vacío = desactivado
CIERRE_DIARIO=
